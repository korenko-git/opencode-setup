{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.6-luna",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://192.168.50.57:1234/v1"
      },
      "models": {
        "ornith-1.0-35b": {
          "name": "ornith-1.0-35b"
        }
      }
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "local-developer": "allow"
        },
        "skill": {
          "*": "deny",
          "project-map": "allow"
        }
      }
    },
    "build": {
      "permission": {
        "task": {
          "*": "allow",
        },
        "skill": {
          "*": "allow",
          "improve-codebase-architecture": "deny",
          "codebase-design": "deny",
        }
      }
    }
  }
}
