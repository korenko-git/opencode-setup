{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.6-luna",
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
        },
        "skill": {
          "*": "deny",
          "project-map": "allow"
        }
      }
    },
    "build": {
      "model": "openai/gpt-5.6-terra",
      "permission": {
        "task": {
          "*": "allow",
        },
        "skill": {
          "*": "deny",
          "project-map": "allow"
        }
      }
    }
  },

  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://192.168.50.57:1234/v1"
      },
      "models": {
        "ornith-1.0-35b": {
          "name": "ornith-1.0-35b"
        }
      }
    }
  },
}