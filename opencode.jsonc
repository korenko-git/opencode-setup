{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5-mini",
  "agent": {
    "plan": {
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "local-developer": "allow"
        },
        "skill": {
          "*": "deny",
          "project-map": "allow"
        }
      }
    },
    "build": {
      "permission": {
        "task": {
          "*": "allow",
        },
        "skill": {
          "*": "allow",
          "improve-codebase-architecture": "deny",
        }
      }
    }
  }
}
